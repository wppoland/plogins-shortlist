#. Plugin Name of the plugin
#: plogins-shortlist.php
msgid "Plogins Shortlist - Wishlist for WooCommerce"
msgstr "Plogins-Shortlist, Wunschliste für WooCommerce"

#. Plugin URI of the plugin
#: plogins-shortlist.php
msgid "https://plogins.com/plogins-shortlist/"
msgstr "https://plogins.com/de/plogins-shortlist/"

#. Description of the plugin
#: plogins-shortlist.php
msgid ""
"Lightweight, accessible WooCommerce wishlist - guest + customer lists, AJAX,"
" My Account, shortcode, no jQuery"
msgstr ""
"Leichte, zugängliche WooCommerce-Wunschliste, Gäste- und Kundenlisten, AJAX,"
" Mein Konto, Shortcode, kein jQuery"

#. Author of the plugin
#: plogins-shortlist.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-shortlist.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-shortlist.php:48
msgid ""
"Plogins Shortlist - Wishlist for WooCommerce requires WooCommerce to be "
"active."
msgstr ""
"Shortlist, Wunschliste für WooCommerce erfordert, dass WooCommerce aktiv "
"ist."

