#, php-format
msgid "Product #%d"
msgstr "Produkt #%d"

#: src/Service/ShortlistPrivacyService.php:85
msgid "Product ID"
msgstr "Produkt-ID"

#: src/Service/ShortlistPrivacyService.php:86
msgid "Product"
msgstr "Produkt"

#: src/Service/ShortlistPrivacyService.php:87
msgid "Added At"
msgstr "Hinzugefügt am"

#: src/Service/ShortlistService.php:57
msgid "Please log in to use your wishlist."
msgstr "Bitte melde dich an, um deine Wunschliste zu verwenden."

#: src/Service/ShortlistService.php:58
msgid "Product not found."
msgstr "Produkt nicht gefunden."

#. translators: 1: wishlist menu label, 2: saved item count
#: src/Service/ShortlistService.php:125
#, php-format
msgctxt "My Account menu label with item count"
msgid "%1$s (%2$d)"
msgstr "%1$s (%2$d)"

#: src/Service/ShortlistService.php:146
msgid "Added to your wishlist."
msgstr "Zu deiner Wunschliste hinzugefügt."

#: src/Service/ShortlistService.php:147
msgid "Removed from your wishlist."
msgstr "Von deiner Wunschliste entfernt."

#: src/Service/ShortlistService.php:148
msgid "Sorry, something went wrong. Please try again."
msgstr "Entschuldigung, etwas ist schief gelaufen. Bitte versuche es erneut."

#: src/Service/WishlistPageService.php:34
msgid "You do not have permission to create pages."
msgstr "Du hast keine Berechtigung zum Erstellen von Seiten."

#: templates/account-wishlist.php:51
msgid "Browse products"
msgstr "Produkte durchsuchen"

#: blocks/wishlist/block.json
msgctxt "block title"
msgid "Shortlist Wishlist"
msgstr "Shortlist-Wunschliste"

#: blocks/wishlist/block.json
msgctxt "block description"
msgid ""
"Show the current shopper's wishlist (the same list as the [shortlist] "
"shortcode)."
msgstr ""
"Zeigt die Wunschliste des aktuellen Käufers (dieselbe Liste wie der "
"Shortcode [shortlist])."

