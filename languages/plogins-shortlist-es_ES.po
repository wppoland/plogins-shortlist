#. Plugin Name of the plugin
#: plogins-shortlist.php
msgid "Plogins Shortlist - Wishlist for WooCommerce"
msgstr "Plogins Shortlist - Lista de deseos para WooCommerce"

#. Plugin URI of the plugin
#: plogins-shortlist.php
msgid "https://plogins.com/plogins-shortlist/"
msgstr "https://plogins.com/es/plogins-shortlist/"

#. Description of the plugin
#: plogins-shortlist.php
msgid ""
"Lightweight, accessible WooCommerce wishlist - guest + customer lists, AJAX,"
" My Account, shortcode, no jQuery"
msgstr ""
"Lista de deseos de WooCommerce ligera y accesible: listas de invitados y "
"clientes, AJAX, Mi cuenta, shortcode, sin jQuery"

#. Author of the plugin
#: plogins-shortlist.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-shortlist.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-shortlist.php:48
msgid ""
"Plogins Shortlist - Wishlist for WooCommerce requires WooCommerce to be "
"active."
msgstr ""
"Plogins Shortlist - Wishlist for WooCommerce requiere que WooCommerce esté "
"activo."

