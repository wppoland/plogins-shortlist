#: src/Service/ShortlistPrivacyService.php:78
#, php-format
msgid "Product #%d"
msgstr "Producto #%d"

#: src/Service/ShortlistPrivacyService.php:85
msgid "Product ID"
msgstr "ID del producto"

#: src/Service/ShortlistPrivacyService.php:86
msgid "Product"
msgstr "Producto"

#: src/Service/ShortlistPrivacyService.php:87
msgid "Added At"
msgstr "Añadido el"

#: src/Service/ShortlistService.php:57
msgid "Please log in to use your wishlist."
msgstr "Inicia sesión para usar tu lista de deseos."

#: src/Service/ShortlistService.php:58
msgid "Product not found."
msgstr "Producto no encontrado."

